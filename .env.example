SERPAPI_KEY=your_serpapi_key_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
# Optional: set to push only to your own LINE account (testing). Leave empty to broadcast to all friends.
LINE_USER_ID=
# Apps Script Web App URL (the /exec URL). When set, routes are read from the shared table instead of config/routes.json.
ROUTES_API_URL=
