SERPAPI_KEY=your_serpapi_key_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
# Optional: set to push only to your own LINE account (testing). Leave empty to broadcast to all friends.
LINE_USER_ID=
# Apps Script Web App URL (the /exec JSON API). Used by GitHub Actions / local runs to fetch routes from Google Sheet.
ROUTES_API_URL=
# Frontend form URL opened by LINE Rich Menu (defaults to GitHub Pages when omitted).
FORM_URL=https://dwyanelin.github.io/fly-together/
